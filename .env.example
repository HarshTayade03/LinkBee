# Environment Configuration Template
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# PostgreSQL Configuration (Docker container maps host port 5433 to container port 5432 to avoid collision with local postgres)
DATABASE_URL=postgres://shortener_user:shortener_pass@localhost:5433/shortener_db

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Security & CORS
ALLOWED_ORIGIN=http://localhost:3000
TRUST_PROXY=false
