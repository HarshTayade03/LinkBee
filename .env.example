# Environment Configuration Template
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# PostgreSQL Configuration (Docker container maps host port 5433 to container port 5432)
DATABASE_URL=postgres://shortener_user:shortener_pass@localhost:5433/shortener_db

# Redis Configuration (Docker container maps host port 6380 to container port 6379)
REDIS_URL=redis://localhost:6380

# Security & CORS
ALLOWED_ORIGIN=http://localhost:3000
TRUST_PROXY=false
